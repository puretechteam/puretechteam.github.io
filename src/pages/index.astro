---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Section from '../components/Section.astro';
import Ledger from '../components/Ledger.astro';
import ProductRows from '../components/ProductRows.astro';
import GamesTeaser from '../components/GamesTeaser.astro';
import Measure from '../components/Measure.astro';
import XPosts from '../components/XPosts.astro';
import AppScan from '../components/AppScan.astro';
import snapshotJson from '../data/snapshot.json';
import xPosts from '../data/x-posts.json';
import { X_HANDLE } from '../data/x.mjs';
import { external } from '../data/nav.ts';
import { products, ledger, measures, parts } from '../data/products.ts';
import { OWNER, SOFTWARE_REPOS } from '../data/roster.mjs';
import type { Snapshot } from '../lib/data.ts';
import {
  formatBytes,
  formatDate,
  isVersionTag,
  latestRelease,
  liveDownload,
  primaryAsset,
  releaseFeed,
  releaseSummary,
  mergedWithin,
  upstreamProjects,
  upstreamPulls,
  versionFromTag,
} from '../lib/data.ts';
import UpstreamProjects from '../components/UpstreamProjects.astro';

const snapshot = snapshotJson as Snapshot;
const latheport = snapshot.repos.Latheport;
const pulls = upstreamPulls(snapshot.pulls, OWNER);
const updates = releaseFeed(snapshot, SOFTWARE_REPOS)
  .filter((f) => isVersionTag(f.release.tag))
  .slice(0, 4);
const live = liveDownload(latheport);
const shownMeasures = measures.map((m) => (m.id === 'download' && live ? { ...m, after: live } : m));
const nameOf = (repo: string) => products.find((p) => p.repo === repo)?.name ?? repo;
const xLink = external.find((e) => e.label === 'X')!.href;
// The newest release, so the first screen has something current to click.
const newest = updates[0]
  ? (() => {
      const product = products.find((p) => p.repo === updates[0].repo);
      return {
        label: `${nameOf(updates[0].repo)} ${versionFromTag(updates[0].release.tag)}`,
        date: formatDate(updates[0].release.publishedAt),
        href: product?.page ? `/software/${product.slug}/` : updates[0].release.url,
      };
    })()
  : null;
// Upstream is shown by project, so the section grows with projects, not pull requests.
const projects = upstreamProjects(pulls, OWNER);
const projectsShown = 4;
const projectsLeft = Math.max(0, projects.length - projectsShown);
const lastWeek = mergedWithin(pulls, 7, snapshot.fetchedAt);
// For scale beside the app check: our smallest current download.
const smallest = products
  .map((p) => {
    const release = latestRelease(snapshot.repos[p.repo]);
    const asset = primaryAsset(release);
    return release && asset ? { name: p.name, version: versionFromTag(release.tag), size: asset.size } : null;
  })
  .filter((d) => d !== null)
  .sort((a, b) => a.size - b.size)[0];
const scale = smallest ? `${smallest.name} ${smallest.version} is a ${formatBytes(smallest.size)} download.` : null;
---

<Base
  title="Pure Tech"
  description="Independent software for Windows. It runs on your own PC, keeps your files there, and every claim comes with a number."
>
  <div class="hero-clip">
  <div class="hero wrap">
    <Mark flat width="min(46rem, 70vw)" class="hero-emboss" />
    <h1 class="display">Nothing extra.</h1>
    <p class="lede">
      Independent software for Windows. It runs on your own PC, keeps your files there, and every claim comes with a
      number.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary cut" href="#software">See the software</a>
      <a class="btn cut hero-scan" href="#scan" data-scan-open>Look inside an app</a>
      {
        newest && (
          <a class="hero-newest mono" href={newest.href}>
            Newest: <b>{newest.label}</b>, {newest.date}
          </a>
        )
      }
    </div>

    <AppScan scale={scale} />

    <div class="removed">
      <p class="removed-intro">
        Here is what that means in practice. <a href="/software/latheport/">Latheport</a>, our file converter, used
        to depend on {ledger.length} other pieces of software. Release by release we replaced each one with our own code.
      </p>
      <Ledger items={ledger} repo={latheport} verbose />
      <p class="mono muted removed-note">Each name links to the release notes that record it.</p>
    </div>
  </div>
  </div>

  <Section num="01" title="Software" id="software">
    <ProductRows products={products} snapshot={snapshot} />
  </Section>

  <Section num="02" title="Games" id="games">
    <GamesTeaser />
  </Section>

  <Section num="03" title="Numbers, with their conditions" id="numbers">
    <div class="measures">
      {shownMeasures.map((m) => <Measure {...m} />)}
    </div>
  </Section>

  <Section num="04" title="Built from our own parts" id="parts">
    <p class="parts-intro">
      Latheport reads most formats itself, through four libraries we wrote and publish. Each one took over from a
      program you used to have to install.
    </p>
    <div class="parts">
      <a class="part part-app cut" href="/software/latheport/">
        <span class="display">Latheport</span>
        <span class="mono">the app</span>
      </a>
      {
        parts.map((p) => (
          <a class="part cut-outline" href={snapshot.repos[p.repo].url}>
            <span class="display">{p.repo}</span>
            <span class="part-does">{p.does}</span>
            <span class="mono part-replaced">
              in place of <span class="strike">{p.replaced}</span>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section num="05" title="Merged upstream" id="upstream">
    <p class="up-lede">
      <b>{pulls.length}</b> pull requests merged into <b>{projects.length}</b> projects we do not own{
        lastWeek > 0 && `, ${lastWeek} of them in the 7 days to ${formatDate(snapshot.fetchedAt)}`
      }.
    </p>
    <UpstreamProjects projects={projects} mode="summary" limit={projectsShown} />
    <p class="mono muted list-note">
      {projectsLeft > 0 && `And ${projectsLeft} more ${projectsLeft === 1 ? 'project' : 'projects'}. `}
      <a class="link" href="/upstream/">All {pulls.length}, by project</a>
    </p>
  </Section>

  <Section num="06" title="Lately" id="updates">
    <div class="lately">
      <div>
        <h3 class="mono lately-head">Releases</h3>
        <ul class="plain-list">
          {
            updates.map(({ repo, release }) => (
              <li class="update">
                <span class="mono muted">{formatDate(release.publishedAt)}</span>
                <a href={release.url}>
                  <strong>
                    {nameOf(repo)} {versionFromTag(release.tag)}
                  </strong>
                </a>
                <span class="muted update-line">{releaseSummary(release)}</span>
              </li>
            ))
          }
        </ul>
        <p class="mono muted list-note"><a class="link" href="/updates/">Every release</a></p>
      </div>
      {
        xPosts.posts.length > 0 && (
          <div id="x">
            <h3 class="mono lately-head">On X</h3>
            <XPosts limit={2} variant="list" />
            <p class="mono muted list-note">
              Copied from <a class="link" href={xLink}>@{X_HANDLE}</a> when the site is built, so this page loads
              nothing from X.
            </p>
          </div>
        )
      }
    </div>
  </Section>
</Base>

<style>
  .hero-clip {
    overflow-x: clip;
  }
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 9vw, 7rem) clamp(3rem, 7vw, 5.5rem);
  }
  .hero :global(.hero-emboss) {
    position: absolute;
    right: calc(var(--gutter) * -1 - 4rem);
    top: -5rem;
    color: var(--emboss);
    z-index: -1;
    pointer-events: none;
  }
  h1 {
    font-size: clamp(3.25rem, 8.6vw, 7.75rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin-left: -0.04em;
  }
  .lede {
    margin-top: clamp(1.25rem, 3vw, 2.25rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }
  /* Opens the app check below. White on dark (dark on light), so it stands apart from the green button. */
  .hero-scan {
    background: var(--paper);
    color: var(--ink);
  }
  .hero-scan:hover {
    background: var(--mist);
  }
  :global(.is-phone) .hero-scan {
    display: none;
  }
  .hero-newest {
    color: var(--mist);
    text-decoration: none;
  }
  .hero-newest b {
    color: var(--paper);
    font-weight: 600;
  }
  .hero-newest:hover b {
    text-decoration: underline;
  }
  /* The hero list is smaller than before, so the software list starts nearer the top. */
  .removed :global(.ledger .strike) {
    font-size: clamp(1.25rem, 2.3vw, 1.875rem);
  }
  .removed {
    margin-top: clamp(2rem, 4.5vw, 3.5rem);
  }
  .removed-intro {
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    margin-bottom: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .removed-note {
    margin-top: 1.5rem;
  }

  .parts-intro {
    color: var(--mist);
    max-width: 36rem;
    margin-bottom: 1.5rem;
  }
  .parts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    --cut: 14px;
  }
  .part {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.1rem 1.4rem;
    text-decoration: none;
  }
  .part .display {
    font-size: 1.25rem;
  }
  .part-app {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    background: var(--paper);
    color: var(--ink);
    padding-block: 0.9rem 1rem;
  }
  .part-does {
    color: var(--mist);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .part-replaced {
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--mist);
  }
  .part-replaced .strike {
    white-space: normal;
    /* Small text, so it takes the secondary color (6.7 to 1) instead of the dimmer struck-word color. */
    color: var(--mist);
  }
  .part-replaced .strike::after {
    display: none;
  }
  .part-replaced .strike {
    text-decoration: line-through;
    text-decoration-color: var(--green);
    text-decoration-thickness: 2px;
  }
  .part:hover .display {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  @media (max-width: 960px) {
    .parts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 440px) {
    .parts {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .update {
    display: grid;
    grid-template-columns: minmax(0, 6.5rem) minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    align-items: baseline;
  }
  .update .update-line {
    grid-column: 2;
  }
  .lately {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem clamp(2rem, 5vw, 4rem);
  }
  .lately-head {
    color: var(--mist);
    font-weight: 400;
    margin-bottom: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line-strong);
  }
  @media (max-width: 960px) {
    .lately {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .update-line {
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .list-note {
    margin-top: 1.25rem;
  }
  @media (max-width: 720px) {
    .update {
      grid-template-columns: minmax(0, 1fr);
    }
    .update .update-line {
      grid-column: auto;
    }
  }
</style>
