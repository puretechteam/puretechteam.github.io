---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import snapshotJson from '../data/snapshot.json';
import { libraries } from '../data/libraries.ts';
import type { Snapshot } from '../lib/data.ts';
import { latestVersion } from '../lib/data.ts';

const snapshot = snapshotJson as Snapshot;
const rows = libraries.map((lib) => {
  const repo = snapshot.repos[lib.repo];
  return { ...lib, url: repo.url, version: latestVersion(repo) };
});
---

<Base
  title="Libraries"
  description="The open-source libraries Pure Tech's software is built from, each written to replace a dependency."
>
  <PageHead title="Libraries">
    The parts our software is built from. We wrote each one to take the place of something you would otherwise have to
    install, and we publish them so you can use them too.
  </PageHead>

  <section class="section" aria-label="All libraries">
    <ul class="wrap libs">
      {
        rows.map((lib) => (
          <li>
            <div class="lib-name">
              <a class="display" href={lib.url}>
                {lib.name}
              </a>
              <p class="mono muted">
                {lib.language} · {lib.license}
                {lib.version && ` · ${lib.version}`}
              </p>
            </div>
            <div class="lib-body">
              <p>{lib.does}</p>
              <p class="without">{lib.without}</p>
              <pre class="mono" tabindex="0" aria-label={`Install command for ${lib.name}`}><code>{lib.install}</code></pre>
              {lib.usedIn && (
                <p class="mono muted">
                  Used in <a class="link" href={lib.usedIn.href}>{lib.usedIn.name}</a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .libs > li {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 0.75rem clamp(1.5rem, 4vw, 4rem);
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .libs > li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .lib-name a {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    text-decoration: none;
  }
  .lib-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .lib-name p {
    margin-top: 0.5rem;
  }
  .lib-body {
    max-width: 44rem;
  }
  .lib-body > * + * {
    margin-top: 0.6rem;
  }
  .without {
    color: var(--green);
  }
  pre {
    margin: 0.9rem 0 0;
    padding: 0.8rem 1rem;
    background: var(--graphite);
    border: 1px solid var(--line);
    overflow-x: auto;
    white-space: pre;
  }
  @media (max-width: 860px) {
    .libs > li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
