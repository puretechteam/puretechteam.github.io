---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import UpstreamProjects from '../components/UpstreamProjects.astro';
import snapshotJson from '../data/snapshot.json';
import { OWNER } from '../data/roster.mjs';
import type { Snapshot } from '../lib/data.ts';
import { formatDate, mergedWithin, upstreamProjects, upstreamPulls } from '../lib/data.ts';

const snapshot = snapshotJson as Snapshot;
const pulls = upstreamPulls(snapshot.pulls, OWNER);
const projects = upstreamProjects(pulls, OWNER);
const lastWeek = mergedWithin(pulls, 7, snapshot.fetchedAt);
const newest = pulls.slice(0, 5);
---

<Base
  title="Upstream"
  description="Pull requests from Pure Tech that were merged into open-source projects we do not own."
>
  <PageHead title="Upstream">
    Changes we sent to other people's open-source projects that their maintainers merged. Only merged pull requests are
    counted. Open ones are not.
  </PageHead>

  <div class="wrap up-stats">
    <p><b class="display">{pulls.length}</b><span class="mono muted">merged</span></p>
    <p><b class="display">{projects.length}</b><span class="mono muted">projects</span></p>
    <p>
      <b class="display">{lastWeek}</b><span class="mono muted">in the 7 days to {formatDate(snapshot.fetchedAt)}</span>
    </p>
  </div>

  <Section num="01" title="By project" id="projects">
    <UpstreamProjects projects={projects} mode="full" />
    <p class="mono muted up-note">Open a project to see its pull requests.</p>
  </Section>

  <Section num="02" title="Newest" id="newest">
    <ul class="plain-list">
      {
        newest.map((p) => (
          <li class="pull">
            <span class="mono pull-repo">{p.repo}</span>
            <a href={p.url}>{p.title}</a>
            <span class="mono muted">{formatDate(p.mergedAt as string)}</span>
          </li>
        ))
      }
    </ul>
    <p class="mono muted up-note">
      {pulls.length} merged in all. Checked against GitHub on {formatDate(snapshot.fetchedAt)}.
    </p>
  </Section>

  <!-- A link to /upstream/#project opens that project's list. -->
  <script is:inline>
    (() => {
      const open = () => {
        const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el && el.tagName === 'DETAILS') el.open = true;
      };
      open();
      addEventListener('hashchange', open);
    })();
  </script>
</Base>
