---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="wrap page-head">
  <h1 class="display">{title}</h1>
  <div class="lede"><slot /></div>
</div>

<style>
  .page-head {
    padding-block: clamp(2rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }
  h1 {
    font-size: clamp(2.75rem, 9vw, 6.5rem);
    letter-spacing: -0.025em;
    margin-left: -0.04em;
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 38rem;
  }
</style>
