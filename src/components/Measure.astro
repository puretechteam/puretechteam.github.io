---
import { barWidths, changePercent, isWorse } from '../lib/data.ts';

interface Value {
  value: number;
  text: string;
  note: string;
  ref?: string;
}
interface Props {
  label: string;
  product?: string;
  before?: Value;
  after: Value;
  conditions: string;
  source: { label: string; url: string };
  /** Which way is an improvement. Every figure on the site so far is smaller-is-better. */
  better?: 'lower' | 'higher';
}
const { label, product, before, after, conditions, source, better = 'lower' } = Astro.props;
const widths = before ? barWidths(before.value, after.value) : null;
// A figure that got worse keeps its bars to scale, but its "after" is not drawn in green:
// green would read as an improvement. The change is spelled out instead.
const worse = !!before && isWorse(before.value, after.value, better);
const change = before && worse ? changePercent(before.value, after.value) : 0;
---

<div class="measure">
  <p class="measure-label mono">
    {product ? `${product}: ${label}` : label}
    {
      worse && (
        <span class="measure-change">
          {change > 0 ? '+' : ''}
          {change}%<span class="sr-only">, a change for the worse</span>
        </span>
      )
    }
  </p>

  {
    before ? (
      <>
        <p class="measure-values">
          <span class="measure-before display">{before.text}</span>
          <span class="measure-to mono">to</span>
          <span class:list={['measure-after display', { worse }]}>{after.text}</span>
        </p>
        <div class="bars" aria-hidden="true">
          <div class="bar bar-before" style={`width:${widths!.before}%`} />
          <div class:list={['bar bar-after', { worse }]} style={`width:${widths!.after}%`} />
        </div>
        <p class="measure-notes mono">
          <span>
            {before.note} {before.ref && <b class="ref-before">{before.ref}</b>}
          </span>
          <span>
            {after.note} {after.ref && <b class:list={['ref-after', { worse }]}>{after.ref}</b>}
          </span>
        </p>
      </>
    ) : (
      <>
        <p class="measure-values">
          <span class="measure-after display single">{after.text}</span>
        </p>
        <div class="bars" aria-hidden="true">
          <div class="bar bar-after" />
        </div>
        <p class="measure-notes mono">
          <span>{after.note}</span>
        </p>
      </>
    )
  }

  <details class="conditions">
    <summary class="mono">How it was measured</summary>
    <p>
      {conditions}
      <a class="link" href={source.url}>{source.label}</a>.
    </p>
  </details>
</div>

<style>
  .single {
    color: var(--paper);
  }
  b {
    font-weight: 600;
  }
  .ref-before {
    color: var(--blue);
  }
  .ref-after {
    color: var(--green);
  }
  .measure-after.worse,
  .ref-after.worse {
    color: var(--paper);
  }
  .bar-after.worse {
    background: var(--paper);
  }
  .measure-change {
    margin-left: 0.6rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line-strong);
    color: var(--paper);
  }
</style>
