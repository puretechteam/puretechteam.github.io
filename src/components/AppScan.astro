---
// "What's in this app?": drop a program's folder to see what it is made of, the program itself and what it carries
// along, and how many lines of code it holds. It all happens in the browser and nothing is sent anywhere. Sorting
// uses file names and sizes only (src/lib/appscan.ts). The line count reads source files and the code packed in
// app.asar (src/lib/loc.ts). The page loads a small starter; the tool (src/lib/scan-ui.ts) comes on first use.
//
// Chrome and Edge's folder picker (showDirectoryPicker) refuses Program Files and AppData, where programs live, so
// the button uses the classic folder input instead. Dragging a folder works anywhere.
interface Props {
  /** One of ours, for scale: "ChildLock 0.3.0 is a 421 KB download." */
  scale?: string | null;
}
const { scale } = Astro.props;
---

<section class="scan cut-outline" id="scan" aria-labelledby="scan-title" data-scan>
  <div class="scan-inner">
    <div>
      <h2 id="scan-title" class="display scan-title">What's in this app?</h2>
      <p class="scan-phone muted">On a PC, drop a program's folder here to see what is inside it.</p>
      <p class="scan-text">
        Some programs bring a whole web browser along, plus runtimes and dozens of languages. Drag a program's folder
        onto this page to see how much of it is the program, how much is extra, and how many lines of code it holds.
        A project's source folder works too.
      </p>
      <p class="mono muted scan-promise">Nothing is uploaded. Your files are read in this page, on your PC.</p>
    </div>
    <div class="scan-drop cut-outline">
      <div>
        <p class="scan-drop-head">Drop a folder here</p>
        <p class="mono muted">or</p>
        <button type="button" class="btn btn-primary cut" data-pick>Choose a folder</button>
        <input type="file" webkitdirectory hidden data-input />
        <p class="mono muted">Your browser may call it an upload. Nothing leaves your PC.</p>
      </div>
    </div>
    <p class="scan-status mono" role="status" data-status></p>
    <div class="scan-result" data-result hidden>
      <p class="scan-name"><strong data-name></strong> <span class="mono muted" data-total></span></p>
      <ol class="plain-list scan-groups" data-groups></ol>
      <p class="mono muted scan-note">
        <span data-note></span>Sorted by file name; open a line to see its files.{scale && ` For scale: ${scale}`}
      </p>
      <div class="scan-loc" data-loc></div>
      <div class="scan-actions">
        <button type="button" class="btn btn-primary cut" data-copy>Copy result</button>
        <button type="button" class="btn btn-quiet" data-again>Try another</button>
      </div>
    </div>
  </div>
  <template data-row>
    <li class="scan-group">
      <details>
        <summary>
          <span class="scan-label"></span>
          <span class="mono scan-size"></span>
          <span class="mono muted scan-pct"></span>
          <span class="scan-bar" aria-hidden="true"><span></span></span>
        </summary>
        <ol class="mono scan-files"></ol>
      </details>
    </li>
  </template>
</section>

<script>
  // A small starter: it takes drops and button presses and fetches the tool itself (src/lib/scan-ui.ts) from this
  // site the first time a file is dragged over the page or a button is pointed at, so the page stays light.
  type Ui = ReturnType<typeof import('../lib/scan-ui.ts').init>;

  const box = document.querySelector<HTMLElement>('[data-scan]');
  if (box && !document.documentElement.classList.contains('is-phone')) {
    const input = box.querySelector<HTMLInputElement>('[data-input]')!;
    let ui: Promise<Ui> | undefined;
    const load = () =>
      (ui ??= import('../lib/scan-ui.ts')
        .then((m) => m.init(box))
        .catch((err) => {
          ui = undefined;
          box.querySelector('[data-status]')!.textContent = 'The tool could not be loaded. Check the connection and try again.';
          throw err;
        }));

    // The whole page takes the drop, so a near miss does not send the browser off to show the folder.
    const isFiles = (e: DragEvent) => !!e.dataTransfer?.types.includes('Files');
    document.addEventListener('dragover', (e) => {
      if (!isFiles(e)) return;
      e.preventDefault();
      box.classList.add('over');
      load().catch(() => {});
    });
    document.addEventListener('dragleave', (e) => {
      if (!e.relatedTarget) box.classList.remove('over');
    });
    document.addEventListener('drop', (e) => {
      if (!isFiles(e)) return;
      e.preventDefault();
      box.classList.remove('over');
      // What was dropped can only be taken during the drop itself, so take it now and hand it over once loaded.
      const entry = e.dataTransfer!.items[0]?.webkitGetAsEntry();
      const file = e.dataTransfer!.files[0];
      load()
        .then((u) => (entry?.isDirectory ? u.folder(entry as FileSystemDirectoryEntry) : file && u.file(file)))
        .catch(() => {});
    });

    // "Choose a folder" in the box and "Look inside an app" in the opening screen open the folder dialog. Without
    // JavaScript the second stays a link to this box.
    for (const b of [box.querySelector('[data-pick]'), document.querySelector('[data-scan-open]')]) {
      b?.addEventListener('pointerenter', () => load().catch(() => {}));
      b?.addEventListener('focus', () => load().catch(() => {}));
      b?.addEventListener('click', (e) => {
        e.preventDefault();
        input.click();
      });
    }
    input.addEventListener('change', () => {
      const list = [...(input.files ?? [])];
      input.value = '';
      if (list.length) load().then((u) => u.list(list)).catch(() => {});
    });
  }
</script>

<style>
  .scan {
    --cut: 22px;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .scan-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    gap: 1.5rem clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .scan-title {
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    letter-spacing: -0.02em;
  }
  .scan-text,
  .scan-phone {
    margin-top: 0.9rem;
    max-width: 36rem;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.5;
  }
  .scan-promise {
    margin-top: 0.9rem;
  }
  .scan-phone {
    display: none;
  }
  :global(.is-phone) .scan-phone {
    display: block;
  }
  :global(.is-phone) .scan-text,
  :global(.is-phone) .scan-promise,
  :global(.is-phone) .scan-drop {
    display: none;
  }
  /* The drop area: plainly a place to put something. It lights up while a folder is dragged over the page. */
  .scan-drop {
    --cut: 14px;
  }
  .scan-drop > div {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  .scan-drop-head {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .scan.over .scan-drop {
    background: var(--paper);
  }
  .scan.over .scan-drop::before {
    background: var(--graphite);
  }
  .scan-status,
  .scan-result {
    grid-column: 1 / -1;
  }
  @media (max-width: 860px) {
    .scan-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .scan-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .scan-status:empty {
    display: none;
  }
  .scan-result {
    display: grid;
    gap: 0.9rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .scan-result[hidden] {
    display: none;
  }
  .scan-name strong {
    font-size: 1.25rem;
    margin-right: 0.5rem;
  }
  .scan-group summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 3rem;
    gap: 0.4rem 1rem;
    align-items: baseline;
    cursor: pointer;
    list-style: none;
  }
  .scan-group summary::-webkit-details-marker {
    display: none;
  }
  .scan-label::before {
    content: '+';
    display: inline-block;
    width: 1.1em;
    color: var(--mist);
    font-family: var(--mono);
  }
  details[open] .scan-label::before {
    content: '-';
  }
  .scan-group summary:hover .scan-label {
    text-decoration: underline;
  }
  .scan-pct {
    text-align: right;
  }
  .scan-bar {
    grid-column: 1 / -1;
    height: 5px;
    background: var(--line);
  }
  .scan-bar span {
    display: block;
    height: 100%;
    min-width: 1px;
    background: var(--mist);
  }
  .scan-group[data-id='program'] .scan-bar span {
    background: var(--paper);
  }
  .scan-files {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0 0.2rem 1.1em;
    color: var(--mist);
  }
  .scan-files :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .scan-files :global(span:first-child) {
    overflow-wrap: anywhere;
  }
  .scan-files :global(span:last-child) {
    flex: none;
  }
  /* Lines of code: filled in by src/lib/loc.ts, which brings the rest of its styles with it. */
  .scan-loc {
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--mist);
  }
  .scan-loc:empty {
    display: none;
  }
</style>
